# Copy to .env and fill in your values
# Get these from browser DevTools → Application → Local Storage → https://boosty.to

# From the "auth" object in Local Storage
BOOSTY_ACCESS_TOKEN=your_access_token_here
BOOSTY_REFRESH_TOKEN=your_refresh_token_here
BOOSTY_EXPIRES_AT=0

# From "_clentId" key in Local Storage (note the typo — that's how Boosty stores it)
BOOSTY_DEVICE_ID=your_device_id_here

# Your blog username for testing (e.g. "my_blog")
BOOSTY_TEST_BLOG=your_blog_username_here
